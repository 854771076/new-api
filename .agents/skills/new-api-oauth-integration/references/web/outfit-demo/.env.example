# Outfit Demo — 换装应用演示
# 基于 supabase-app-starter 模板，预填 Supabase 项目配置
# 复制为 .env.local 并填写你的网关地址即可运行

# Supabase 项目配置（已预填）
VITE_SUPABASE_URL=https://jknkenfhhwpxwwgqmcxv.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Y1bDLtBvaQktz_na-W9o_A_sxB5NfTO

# new-api 网关配置
# 注意：client_id 由网关「创建 OAuth App」时自动生成（形如 nac_xxxxxxxx），
# 不存在固定值，必须从后台「OAuth 应用」列表复制
VITE_GATEWAY_BASE_URL=http://localhost:3000
VITE_GATEWAY_CLIENT_ID=nac_xxxxxxxxxxxxxxxxxxxxxx
