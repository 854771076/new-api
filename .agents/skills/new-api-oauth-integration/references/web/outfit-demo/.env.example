# Outfit Demo — 换装应用演示
# 参考应用位于 skills/new-api-oauth-integration/references/web/outfit-demo
# 复制为 .env.local 并填写网关地址与 client_id 即可运行

# ---------------------------------------------------------------------------
# Supabase 项目配置（已预填演示项目，anon/publishable key 可公开进前端）
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://jknkenfhhwpxwwgqmcxv.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Y1bDLtBvaQktz_na-W9o_A_sxB5NfTO

# ---------------------------------------------------------------------------
# new-api 网关配置
# ---------------------------------------------------------------------------
# 本应用是公共客户端（public_client）：
#   - 没有 client_secret，授权码交换依赖 PKCE
#   - 不要在 .env、前端代码或 Supabase provider 里配置任何网关密钥
#
# client_id 由网关「创建 OAuth App」时自动生成（形如 nac_xxxxxxxx），
# 不存在固定值，必须从后台「OAuth 应用」列表复制。
# 该应用需要勾选「公共客户端」，并把 redirect URI 配成
# <SUPABASE_URL>/auth/v1/callback。
VITE_GATEWAY_BASE_URL=http://localhost:3000
VITE_GATEWAY_CLIENT_ID=nac_xxxxxxxxxxxxxxxxxxxxxx

# Supabase custom provider 的标识必须是 custom:newapi（含 custom: 前缀），
# 且 provider 的 issuer 与网关后台「服务器地址」完全一致。

# ---------------------------------------------------------------------------
# 令牌刷新说明
# ---------------------------------------------------------------------------
# 网关 access token 有效期 1 小时，Supabase 不会自动刷新 provider token。
# 应用需在调用 /v1/* 前，用会话里的 provider_refresh_token 调网关 /oauth/token
# 换取新的 access token，并保存轮换后的 refresh token；
# 若返回 invalid_grant，说明刷新链已失效，需要重新登录。

# ---------------------------------------------------------------------------
# Edge Function secrets（不会打包进前端；用 supabase secrets set 设置）
# ---------------------------------------------------------------------------
# GATEWAY_BASE_URL=https://<公网网关地址>
# GATEWAY_CLIENT_ID=nac_xxxxxxxxxxxxxxxxxxxxxx
# GATEWAY_OIDC_PROVIDER=custom:newapi
# APP_ORIGIN=http://localhost:5173
