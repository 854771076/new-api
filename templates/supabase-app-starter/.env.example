# ===== Supabase =====
# Copy this file to .env.local and fill in values after Step 2 (Supabase OIDC setup).
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>

# ===== new-api Gateway =====
# The gateway must already have an OAuthApp created for this App (Step 1).
# The app must be created as a public client (public_client), so it has no
# client_secret: the browser authenticates with client_id + PKCE only.
VITE_GATEWAY_BASE_URL=https://<your-gateway-host>
VITE_GATEWAY_CLIENT_ID=nac_xxxxxxxxxxxxxxxx

# Supabase custom provider identifier must be custom:newapi (the custom: prefix
# is mandatory), and its issuer must equal the gateway public server address.

# ===== Gateway token lifecycle =====
# The gateway access token lives for 1 hour. Supabase never refreshes a custom
# provider's token, so the app must refresh it itself:
#   POST <gateway>/oauth/token
#     grant_type=refresh_token&client_id=<client_id>&refresh_token=<provider_refresh_token>
# No client_secret is sent. Keep the rotated refresh token returned by the
# response; an invalid_grant means the chain is dead and the user must log in
# again. src/lib/gatewayAuth.ts implements this.

# ===== Edge Function secrets =====
# These are NOT exposed to the browser. Set them with:
#   supabase secrets set GATEWAY_BASE_URL=... GATEWAY_CLIENT_ID=... \
#     GATEWAY_OIDC_PROVIDER=custom:newapi APP_ORIGIN=https://<your-app-origin>
# GATEWAY_BASE_URL=https://<your-gateway-host>
# GATEWAY_CLIENT_ID=nac_xxxxxxxxxxxxxxxx
# GATEWAY_OIDC_PROVIDER=custom:newapi
# APP_ORIGIN=https://<your-app-origin>
